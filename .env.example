# Optional: T3 Connect-compatible source builds
# SimplyCode does not operate a hosted relay. Cloud features stay disabled unless
# you point the app at a relay and Clerk application that you control. These are
# public client identifiers, not secrets; do not add server-side secrets here.

# Clerk instance for your own relay deployment. Get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
# T3CODE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# T3CODE_CLERK_JWT_TEMPLATE=replace-me
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=replace-me

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in T3CODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/simplycode.provisionprofile
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Your T3 Connect-compatible relay.
# T3CODE_RELAY_URL=https://relay.example.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://hosted.simplycode.invalid; override to test against a staging deployment.
# T3CODE_HOSTED_APP_URL=https://hosted.example.com
